{
  "name": "barangay-connect/dba-verification",
  "description": "Test-only DBA harness; P1 owns the application scaffold and dependency policy.",
  "require-dev": {
    "orchestra/testbench": "11.3.0",
    "laravel/pint": "1.32.1"
  },
  "autoload": {
    "psr-4": {
      "App\\": "../../app/",
      "Database\\Seeders\\": "../../database/seeders/",
      "Database\\Factories\\": "../../database/factories/"
    }
  },
  "autoload-dev": {"psr-4": {"Tests\\": "../"}},
  "config": {"allow-plugins": false}
}
