APP_NAME="Barangay Connect"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://127.0.0.1:8000
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=barangay_connect
DB_USERNAME=
DB_PASSWORD=

# Private local sessions/cache let the scaffold boot before DBA tables exist.
# Production requires reviewed database session/cache/queue configuration.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_COOKIE=barangay_connect_session
SESSION_PATH=/
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_SERIALIZATION=json
CACHE_STORE=file
QUEUE_CONNECTION=database
QUEUE_FAILED_DRIVER=database-uuids

FILESYSTEM_DISK=local
HASH_DRIVER=argon2id

# Fail closed until the DBA identity contract has passed integration tests.
IDENTITY_ENABLED=false
P2_MODULES_ENABLED=false
OUTBOX_DISPATCH_ENABLED=false
DB_QUEUE_RETRY_AFTER=180

# DBA-owned delivery configuration; blank/false values authorize no external send.
SMS_ENABLED=false
SEMAPHORE_API_KEY=
SEMAPHORE_SENDER_NAME=
SMS_TEST_RECIPIENT_ALLOWLIST=
SMS_DAILY_SEGMENT_BUDGET=0
SMS_MAX_SEGMENTS=1
SMS_DESTINATION_PEPPER=
MAKE_ENABLED=false
MAKE_WEBHOOK_URL=
MAKE_WEBHOOK_API_KEY=
MAKE_CREDENTIAL_ID=announcement-v1
MAKE_COMMAND_TOKEN=
MAKE_BARANGAY_ID=0

# Configure a real mail provider privately before recovery is enabled.
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="Barangay Connect"
